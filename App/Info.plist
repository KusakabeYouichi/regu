<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 複数ウィンドウは無効。INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES だと
	     INFOPLIST_KEY_UIApplicationSupportsMultipleScenes = NO を指定しても true で生成される(Xcode 27.1 で確認)。
	     そのため生成を NO にし、ここに明示する -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
